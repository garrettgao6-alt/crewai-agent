OPENAI_API_KEY=your_openai_api_key
TAVILY_API_KEY=your_optional_tavily_api_key
LOG_LEVEL=INFO
OTEL_SDK_DISABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
COOKIE_SECRET_KEY=change-me-cookie-secret
MAX_USERS=3

# MAX_USERS=0 means unlimited users.

# Approved server directory containing NCC PDF/TXT references.
# Create it and grant the application service user read access before enabling.
NCC_DOCUMENT_ROOT=/srv/gaointelligence/ncc

# Public AI uses only bundled synthetic samples. Zero disables either budget.
# Daily reset: midnight Australia/Melbourne. Values cannot exceed these ceilings.
GUEST_AI_ENABLED=true
GUEST_AI_GLOBAL_REQUESTS=20
GUEST_AI_GLOBAL_TOKENS=100000
GUEST_AI_SESSION_REQUESTS=3
GUEST_AI_SESSION_TOKENS=30000

# Optional protected operator NCC catalog, relative to NCC_DOCUMENT_ROOT.
# Guest AI never reads this source. An account can override or disable it.
NCC_DEFAULT_REFERENCE=

# Password recovery email: TLS is mandatory (STARTTLS or implicit TLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false

# DigitalOcean blocks SMTP. Gmail API uses HTTPS and gmail.send-only OAuth.
MAIL_PROVIDER=smtp
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
