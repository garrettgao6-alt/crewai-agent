[Unit]
Description=Gao Intelligence private health and alert monitor
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
UMask=0077
ExecStart=/bin/bash /root/crewai-agent/deploy/run_operations.sh monitor
TimeoutStartSec=180
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/gaointelligence-ops
